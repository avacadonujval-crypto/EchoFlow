{
  "name": "echoflow",
  "version": "1.0.0",
  "description": "Voice dictation and command assistant for Windows — speak to type, speak to act.",
  "main": "dist-electron/main.js",
  "author": "EchoFlow",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.json --noEmit && vite build && electron-builder",
    "build:installer": "node scripts/ensure-pack-env.mjs && vite build && electron-builder --win --x64",
    "build:release": "npm run typecheck && node scripts/ensure-pack-env.mjs && vite build && electron-builder --win --x64 && node scripts/stage-website.mjs",
    "build:dir": "node scripts/ensure-pack-env.mjs && vite build && electron-builder --dir",
    "preview": "vite preview",
    "electron:dev": "vite",
    "website:dev": "npx --yes serve website -p 8080",
    "website:deploy:netlify": "npx --yes netlify-cli deploy --prod --dir=website",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test:matcher": "tsx scripts/test-matcher.ts",
    "postinstall": "echo EchoFlow deps ready"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "electron-store": "^8.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "com.echoflow.app",
    "productName": "EchoFlow",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "privacy-policy.html"
    ],
    "extraResources": [
      {
        "from": ".env",
        "to": ".env"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "EchoFlow-Setup-${version}.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "EchoFlow"
    }
  }
}
